# HackSphere Backend Environment Configuration
PROJECT_NAME="HackSphere API"
VERSION="1.0.0"
DESCRIPTION="HackSphere Hackathon Management Platform API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# Database Configuration (Optional - Defaults to local SQLite in /database/hacksphere.db)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/hacksphere
# POSTGRES_SERVER=localhost
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DB=hacksphere
# POSTGRES_PORT=5432
