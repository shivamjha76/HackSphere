# HackSphere Backend Environment Template
PROJECT_NAME="HackSphere API"
VERSION="1.0.0"
DESCRIPTION="HackSphere - One Platform for Complete Hackathon Management"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

HOST="127.0.0.1"
PORT=8000

# Leave DATABASE_URL empty to use local SQLite (database/hacksphere.db),
# or specify PostgreSQL connection string for production:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hacksphere

SECRET_KEY="hacksphere-super-secure-production-ready-jwt-secret-key-2026-xyz-token-generator"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
